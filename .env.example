
# Gesture runs fully offline with zero configuration.
# Everything below is optional enrichment.

# --- Agent layer -----------------------------------------------------------
# When AWS credentials are present, Barnaby speaks through Strands + Bedrock.
# When they are absent, Barnaby speaks through the local voice engine.
# Both paths pass through the same banned-phrase guard.
GESTURE_USE_STRANDS=1
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# Credentials come from the standard AWS chain (env vars, ~/.aws, or an
# instance role) — set them the usual way, e.g.:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Barnaby answers in a couple of short sentences. These bound length (fast,
# cheap) and control how loose he gets. Temperature is the main dial when
# tuning the prompt against the guard — lower it if he drifts.
BEDROCK_MAX_TOKENS=220
BEDROCK_TEMPERATURE=0.7

# --- Storage ---------------------------------------------------------------
GESTURE_DB=gesture.db

# On startup, if the database holds no days at all, write a week of demo
# history behind today so The Window has weather to draw. Never overwrites
# real data. Off by default — this is for hosted demos, not your own week.
GESTURE_SEED_ON_EMPTY=0

# Filming aids. When on, an on-screen demo panel (reset & seed, bring a
# check-in due, trip the guard live, jump to the curtain call) appears, and the
# /api/demo/* endpoints are enabled. Off by default; the reset wipes data, so
# never turn this on in production.
GESTURE_DEMO=0

# --- Barnaby hardware ------------------------------------------------------
# simulated = on-screen Barnaby (default, always works)
# keepon    = physical My Keepon unit over serial
GESTURE_DEVICE=simulated
GESTURE_KEEPON_PORT=/dev/ttyUSB0
